# Copie para .env (uso local) ou cole estas variáveis na aba
# "Environment Variables" do recurso no Coolify.
# Todos os valores abaixo já são os defaults do docker-compose.yml —
# só declare o que você quer mudar.

# =====================================================================
# OBRIGATÓRIO
# =====================================================================

# Senha do RCON. Não tem default: o deploy falha se estiver ausente.
# Gere uma forte:  openssl rand -base64 24
RCON_PASSWORD=

# =====================================================================
# ORÇAMENTO DE RECURSOS  —  ajuste aqui se o VPS for diferente de 2 vCPU / 8 GB
# =====================================================================

# Limite de memória do container. Confira quanto sobra antes de subir:
#   free -h && docker stats --no-stream
MC_MEM_LIMIT=4G

# Heap da JVM. Mantenha em ~75% de MC_MEM_LIMIT.
# Se subir MC_MEM_LIMIT para 6G, este vai para 4G — não para 6G.
MC_MAX_MEMORY=3G

# Limite de CPU. Em 2 vCPU, deixe pelo menos 0.5 para o Coolify.
MC_CPU_LIMIT=1.5

# =====================================================================
# PERFORMANCE  —  em 2 vCPU estas duas pesam mais que a RAM
# =====================================================================

# Raio de chunks enviados ao cliente. Cada +1 custa CPU e banda.
# 10 é o default do Minecraft. 7 é visualmente aceitável e bem mais leve.
MC_VIEW_DISTANCE=7

# Raio onde mobs, redstone e crescimento realmente rodam.
# Deve ser <= MC_VIEW_DISTANCE. É a alavanca de CPU mais forte que existe.
MC_SIMULATION_DISTANCE=5

# =====================================================================
# SERVIDOR
# =====================================================================

# Versão do Minecraft. LATEST pega a última build estável do Paper.
#
# ACOPLADO A MC_IMAGE_TAG: cada versão do Minecraft exige uma versão mínima
# de Java. Se a imagem tiver Java velho, o servidor sai com exitCode 1 em
# loop e a porta nunca abre. Ex.: MC 26.1 exige Java 25.
#
# Depois que o servidor subir, PINE a versão com o número exato que aparece
# no log — assim um redeploy não troca de versão debaixo dos seus jogadores,
# obrigando todos a atualizar o cliente sem aviso:
#   docker logs $(docker ps -qf name=minecraft) | grep -i "server version"
MC_VERSION=LATEST

# Tag da imagem = versão do Java. Opções: java8, java11, java17, java21, java25.
# java25 roda tudo que é moderno; só mude se precisar rodar MC muito antigo
# (1.16 e anteriores quebram em Java novo).
MC_IMAGE_TAG=java25

# Com MC_ONLINE_MODE=FALSE, vale trocar para uma porta fora do padrão.
# Scanners varrem a internet procurando 25565 especificamente; mudar não é
# segurança de verdade, mas corta a maior parte do tráfego automatizado.
# Se mudar, conecte com IP:PORTA e mantenha o segundo número em 25565:
#   ports: - "25599:25565"  (o compose já faz isso via MC_PORT)
MC_PORT=25565
MC_MAX_PLAYERS=10
MC_DIFFICULTY=normal
MC_MODE=survival
MC_MOTD=Servidor Paper
# Nome da pasta do mundo. Trocar este valor gera um mundo NOVO e preserva o
# antigo em disco — é o jeito reversível de mudar de semente.
MC_LEVEL=world

# Semente do mundo. Vazio = aleatória.
# SÓ VALE NA CRIAÇÃO DO MUNDO. Se o mundo de MC_LEVEL já existe, é ignorada
# sem erro nenhum. Para aplicar uma semente nova, mude MC_LEVEL junto.
MC_SEED=

# 0 = desliga a proteção de spawn (útil quando todos são amigos)
MC_SPAWN_PROTECTION=0

TZ=America/Sao_Paulo

# =====================================================================
# ACESSO
# =====================================================================

# FALSE = aceita cliente pirata (sem conta Microsoft/Mojang).
# TRUE  = só contas legítimas, validadas contra a Microsoft.
#
# Com FALSE o servidor confia no nome que o cliente digitar. Qualquer pessoa
# pode entrar com o SEU nick — inclusive um nick que seja op. As mitigações
# abaixo deixam de ser opcionais.
MC_ONLINE_MODE=FALSE

# Operadores, separados por vírgula.
# COM MC_ONLINE_MODE=FALSE, DEIXE VAZIO. Um op definido por nome, num
# servidor que não autentica nome, é conta de admin sem senha exposta na
# internet. Dê op por RCON com a pessoa já conectada:
#   docker exec $(docker ps -qf name=minecraft) rcon-cli op SeuNick
MC_OPS=

# Whitelist. Com MC_ONLINE_MODE=FALSE, MANTENHA TRUE.
# Ela é falsificável (compara nome), mas ainda barra scanner automatizado e
# curioso que só sabe o IP. Sem ela, o servidor é aberto ao mundo.
MC_ENABLE_WHITELIST=TRUE
MC_WHITELIST=

# =====================================================================
# AUTOPAUSE (opcional)
# =====================================================================

# TRUE suspende a JVM quando ninguém está online — devolve praticamente
# toda a CPU ao host. Custo: a primeira conexão depois da pausa costuma
# expirar, e o jogador precisa tentar de novo.
MC_ENABLE_AUTOPAUSE=FALSE

# Segundos de servidor vazio antes de pausar.
MC_AUTOPAUSE_TIMEOUT=1800

# =====================================================================
# PAINEL WEB (servico `panel`)
# =====================================================================

# Dominio do painel. Crie o registro no Cloudflare com a nuvem LARANJA
# (o painel e HTTP, ao contrario do jogo).
PANEL_FQDN=https://painel.inkttoo.com

# Cloudflare Access. Sem estas duas o painel recusa toda requisicao.
#   TEAM_DOMAIN: Zero Trust > Settings > Custom Pages
#   AUD:         Zero Trust > Access > Applications > sua app > Overview
CF_ACCESS_TEAM_DOMAIN=sua-org.cloudflareaccess.com
CF_ACCESS_AUD=

PANEL_MEM_LIMIT=256M
PANEL_CPU_LIMIT=0.3
